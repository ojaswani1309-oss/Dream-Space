# Copy to .env and edit. These values are read by dream_space/settings.py
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=UTC

DB_NAME=dream_space
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Password reset emails are printed in the terminal by default.
# For real email, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and the EMAIL_* values.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Dream Space <no-reply@dreamspace.local>
